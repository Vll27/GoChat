generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Acceso {
  id              String   @id @map("_id") @default(auto()) @db.ObjectId
  usuarioAsignado String
  tokenLlave      String   @unique
  creadoEn        DateTime @default(now())
}
